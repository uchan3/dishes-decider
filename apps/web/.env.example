# PWA が Supabase に接続するための公開値（クライアントに露出してよい。行アクセスは RLS で防御）。
# .env.local にコピーして実際の値を入れる（.env.local は git 管理外）。
#
# キーは publishable key（sb_publishable_...）を推奨。Supabase dashboard →
# Project Settings → API Keys → Publishable key。旧 anon key も可（後方互換）。
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 旧 anon key を使う場合は代わりに以下を設定:
# VITE_SUPABASE_ANON_KEY=<anon-public-key>
