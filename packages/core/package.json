{
  "name": "@recipe-planner/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "純粋 TypeScript のドメインロジック。ブラウザ (apps/web) と Deno (supabase/functions) の両方から import される。ランタイム npm 依存ゼロ。",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./generation": "./src/generation/index.ts",
    "./shopping": "./src/shopping/index.ts",
    "./normalize": "./src/normalize/index.ts",
    "./similarity": "./src/similarity/index.ts",
    "./extraction": "./src/extraction/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./pantry": "./src/pantry/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
